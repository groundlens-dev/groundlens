{
  "name": "groundlens",
  "version": "1.0.0",
  "description": "Check AI answers against your documents before you send them: wrong figures, arithmetic that does not add up, figures from the wrong company. Deterministic, no second model.",
  "author": {
    "name": "Javier Marín",
    "email": "javier@groundlens.dev",
    "url": "https://groundlens.dev"
  },
  "homepage": "https://groundlens.dev",
  "repository": "https://github.com/groundlens-dev/groundlens",
  "license": "Apache-2.0",
  "keywords": [
    "verification",
    "hallucination",
    "rag",
    "fact-checking",
    "guardrails",
    "mcp"
  ],
  "mcpServers": {
    "groundlens": {
      "command": "uvx",
      "args": [
        "--from",
        "groundlens[mcp]==6.0.5",
        "groundlens",
        "mcp"
      ]
    }
  },
  "icon": "./.claude-plugin/icon.png"
}
